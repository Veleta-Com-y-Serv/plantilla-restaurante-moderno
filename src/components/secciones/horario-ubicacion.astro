---
// Horario y ubicación: a la izquierda el titular, el horario (`horario` [{dia, horas}], sin él `contacto.horario`)
// con filetes finos, la dirección de site.yaml → contacto y los botones «Cómo llegar» y teléfono. A la derecha,
// a sangre hasta el borde, la foto (`imagen`, la fachada) o un plano dibujado. Con `mapa: true` y dirección, un botón
// «Ver el mapa aquí» carga Google Maps en ese hueco solo al pulsarlo (sin cookies de terceros antes); sin
// JavaScript, el botón abre el mapa en otra pestaña. Las horas con «Cerrado» salen apagadas.
import { seccion, site, mapa, tel } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Banda from '../ui/Banda.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const id = Astro.props.id;
const s = seccion(id);
const c = site.contacto;
const conMapa = !!(s && s.mapa === true && c.direccion);
const incrustado = c.direccion ? `https://maps.google.com/maps?q=${encodeURIComponent(c.direccion)}&z=16&output=embed` : '';
const panel = !!(s && (s.imagen || conMapa));
const cerrado = (h: string) => /cerrado/i.test(h);
---

{
  s && (
    <Banda id={id} color="fondo" class="banda--sin-relleno" contenedor={false}>
      <div class:list={[panel ? 'mitades' : 'contenedor py-[var(--ritmo)] md:py-[var(--ritmo-md)] max-w-4xl']}>
        <div class:list={[{ 'mitad-texto': panel }]}>
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="titular--pegado" />
          {s.horario.length > 0 ? (
            <table class="horario">
              <caption class="sr-only">Horario</caption>
              <tbody>
                {s.horario.map((h) => (
                  <tr class:list={[{ cerrado: cerrado(String(h.horas ?? '')) }]}>
                    <th scope="row">{h.dia}</th>
                    <td>{h.horas}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            c.horario && <p class="horario-suelto">{c.horario}</p>
          )}
          {c.direccion && (
            <p class="direccion">
              <Icono nombre="mapa" class="mt-0.5 shrink-0 text-acento" />
              <span>{c.direccion}</span>
            </p>
          )}
          {(c.direccion || c.telefono) && (
            <div class="botones">
              {c.direccion && (
                <a class="btn" href={mapa(c.direccion)} rel="noopener" target="_blank">
                  Cómo llegar
                </a>
              )}
              {c.telefono && (
                <a class="btn-sec" href={tel(c.telefono)}>
                  <Icono nombre="telefono" tam={18} /> {c.telefono}
                </a>
              )}
            </div>
          )}
        </div>
        {panel && (
          <div class:list={['mapa-panel', s.imagen ? 'mapa-panel--foto' : 'mapa-panel--plano']} data-mapa-panel>
            {s.imagen ? (
              <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} />
            ) : (
              <Icono nombre="mapa" tam={56} class="mapa-pin" />
            )}
            {conMapa && (
              <div class="mapa-acciones">
                <a class="btn btn--claro" href={mapa(c.direccion)} rel="noopener" target="_blank" data-mapa={incrustado}>
                  <Icono nombre="mapa" tam={18} /> Ver el mapa aquí
                </a>
                <p class="mapa-aviso">Al pulsar se carga Google Maps.</p>
              </div>
            )}
          </div>
        )}
      </div>
    </Banda>
  )
}
<script is:inline>
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('[data-mapa]');
    if (!a || !a.dataset.mapa) return;
    e.preventDefault();
    var panel = a.closest('[data-mapa-panel]');
    if (!panel || panel.querySelector('iframe')) return;
    var f = document.createElement('iframe');
    f.src = a.dataset.mapa;
    f.title = 'Mapa';
    f.loading = 'lazy';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    panel.appendChild(f);
    a.parentNode.remove();
  });
</script>
