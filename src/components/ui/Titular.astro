---
// Titular de sección: antetítulo con línea de color + título redondeado muy pesado + texto. Sin campos, no pinta nada.
interface Props { titulo?: string; antetitulo?: string; texto?: string; class?: string; nivel?: 1 | 2 }
const { titulo, antetitulo, texto, class: clase = '', nivel = 2 } = Astro.props;
const H = nivel === 1 ? 'h1' : 'h2';
---

{
  (titulo || antetitulo || texto) && (
    <div class:list={['titular', clase]}>
      {antetitulo && <p class="antetitulo">{antetitulo}</p>}
      {titulo && <H class="titulo-seccion">{titulo}</H>}
      {texto && <p class="titular-texto">{texto}</p>}
    </div>
  )
}
