---
// Ejemplo de página adicional: usa el layout base y se enlaza desde el pie (o desde site.yaml → menu).
// Cabecera en banda oscura a todo el ancho y el texto en dos columnas (índice a la izquierda en escritorio).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda banda--oscura">
    <div class="contenedor">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="titulo-seccion">Aviso legal y privacidad</h1>
    </div>
  </section>
  <section class="banda banda--fondo">
    <div class="contenedor grid gap-10 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <ul class="hidden lg:block space-y-3 font-display text-xl lg:sticky lg:top-28 lg:self-start">
        <li>Quiénes somos</li>
        <li>Qué datos tratamos</li>
        <li>Cuánto tiempo</li>
        <li>Tus derechos</li>
        <li>Cookies</li>
      </ul>
      <article class="texto-largo max-w-3xl">
        <h2>Quiénes somos</h2>
        <p>
          Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
            c.email || 'nuestro correo de contacto'
          }{c.telefono && ` o llamarnos al ${c.telefono}`}.
        </p>
        <h2>Qué datos tratamos</h2>
        <p>
          Solo los que nos envías al escribirnos o al hacer un encargo: nombre, forma de contacto, la fecha que nos
          pidas y tu mensaje. Los usamos para responderte. No los cedemos a nadie salvo obligación legal.
        </p>
        <h2>Cuánto tiempo los guardamos</h2>
        <p>El necesario para atender tu consulta o tu encargo y, después, el que marque la ley.</p>
        <h2>Tus derechos</h2>
        <p>
          Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
          puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
        </p>
        <h2>Cookies</h2>
        <p>Esta web no usa cookies de seguimiento.</p>
        <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
      </article>
    </div>
  </section>
</Base>
